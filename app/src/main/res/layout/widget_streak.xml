<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_notification" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
            android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="#FFFFFF" android:textSize="40sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="4dp"
            android:text="day streak" android:textColor="#C8FFFFFF" android:textSize="13sp" />
    </LinearLayout>

    <TextView android:id="@+id/w_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:text="" android:textColor="#C8FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <ImageView android:id="@+id/w_d0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:scaleType="centerInside" android:src="@drawable/widget_dot_off" android:contentDescription="@null" />
        <ImageView android:id="@+id/w_d1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:scaleType="centerInside" android:src="@drawable/widget_dot_off" android:contentDescription="@null" />
        <ImageView android:id="@+id/w_d2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:scaleType="centerInside" android:src="@drawable/widget_dot_off" android:contentDescription="@null" />
        <ImageView android:id="@+id/w_d3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:scaleType="centerInside" android:src="@drawable/widget_dot_off" android:contentDescription="@null" />
        <ImageView android:id="@+id/w_d4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:scaleType="centerInside" android:src="@drawable/widget_dot_off" android:contentDescription="@null" />
        <ImageView android:id="@+id/w_d5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:scaleType="centerInside" android:src="@drawable/widget_dot_off" android:contentDescription="@null" />
        <ImageView android:id="@+id/w_d6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp" android:scaleType="centerInside" android:src="@drawable/widget_dot_off" android:contentDescription="@null" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp">
        <TextView android:id="@+id/w_l0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#C8FFFFFF" android:textSize="10sp" />
        <TextView android:id="@+id/w_l1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#C8FFFFFF" android:textSize="10sp" />
        <TextView android:id="@+id/w_l2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#C8FFFFFF" android:textSize="10sp" />
        <TextView android:id="@+id/w_l3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#C8FFFFFF" android:textSize="10sp" />
        <TextView android:id="@+id/w_l4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#C8FFFFFF" android:textSize="10sp" />
        <TextView android:id="@+id/w_l5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#C8FFFFFF" android:textSize="10sp" />
        <TextView android:id="@+id/w_l6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#C8FFFFFF" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
