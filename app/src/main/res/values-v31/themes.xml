<resources>
    <!-- Android 12+ system splash: plain red; the in-app splash shows the logotype -->
    <style name="Theme.Volapace" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#D90429</item>
        <item name="android:colorAccent">#D90429</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">#D90429</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
